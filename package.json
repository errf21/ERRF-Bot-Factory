{
  "name": "errf-bot-factory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "wrangler dev",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "validate:migrations": "python3 scripts/validate_migrations.py",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:migrations && npm run validate:tooling && npm run build",
    "configure": "node scripts/configure.mjs",
    "deploy": "node scripts/deploy.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "validate:tooling": "node scripts/validate_tooling.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
